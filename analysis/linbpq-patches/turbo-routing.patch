 extern int PREFERINP3ROUTES;
 
+#ifdef TURBO_ROUTING
+/*
+ * TURBO — optimised NET/ROM routing designed to beat stock NET/ROM
+ * on both convergence time and overhead.
+ *
+ * Strategy: be MORE aggressive than NET/ROM during convergence,
+ * then LESS aggressive once stable.
+ *
+ *  1. FAST-START: 15-second broadcast interval for the first 5 cycles
+ *     after startup, then switch to normal L3INTERVAL.
+ *  2. FLOOD-ON-NEW: when a genuinely NEW destination is discovered
+ *     (not just a quality update), schedule an immediate re-broadcast
+ *     after a short random delay (1-4 seconds). This fires at most
+ *     once per new destination (~9 times in a 10-node network).
+ *  3. ADAPTIVE BACKOFF: once the routing table has been stable for
+ *     3 consecutive cycles, double the interval (up to 4×). Any
+ *     change resets to base interval.
+ *  4. JITTER: ±25% on all periodic timers.
+ *  5. MEASURED QUALITY: EWMA of frame success rate adjusts route quality.
+ */
+
+#include <stdlib.h>
+
+static int  turboInited = 0;
+static int  turboCycleCount = 0;
+static int  turboStableCycles = 0;
+static int  turboAdaptiveMult = 1;
+static int  turboNewDestPending = 0;
+static int  turboNewDestTimer = 0;
+static int  turboLastNodeCount = 0;
+static int  turboFastTimer = 1;     /* counts down in L3FastTimer (1-sec ticks) */
+static int  turboFastDone = 0;      /* set after fast-start phase complete */
+static UCHAR turboMeasuredQual[64];
+
+#define TURBO_FAST_CYCLES     5    /* how many fast broadcasts on startup */
+#define TURBO_FAST_INTERVAL   15   /* seconds between fast broadcasts */
+#define TURBO_STABLE_THRESH   3    /* stable cycles before backoff */
+#define TURBO_MAX_MULT        4
+#define TURBO_JITTER_PCT      25
+#define TURBO_MQ_ALPHA        30   /* EWMA weight for new sample */
+#define TURBO_MQ_MIN_FRAMES   10
+
+static int turboRand(int max)
+{
+	if (max <= 0) return 0;
+	return rand() % (max + 1);
+}
+
+static int turboJitter(int base)
+{
+	int jit = (base * TURBO_JITTER_PCT) / 100;
+	if (jit < 1) return base;
+	return base - jit + turboRand(2 * jit);
+}
+
+static void turboInit(void)
+{
+	int i;
+	if (turboInited) return;
+	for (i = 0; i < 64; i++)
+		turboMeasuredQual[i] = 255;
+	turboInited = 1;
+	srand((unsigned int)time(NULL) ^ (unsigned int)getpid());
+}
+
+static int turboRouteIndex(struct ROUTE * ROUTE)
+{
+	int idx = (int)(ROUTE - NEIGHBOURS);
+	if (idx < 0 || idx >= 64) return -1;
+	return idx;
+}
+
+static int turboEffectiveQual(struct ROUTE * ROUTE)
+{
+	int idx = turboRouteIndex(ROUTE);
+	int total, successPct, newMQ, baseQual;
+
+	if (idx < 0) return ROUTE->NEIGHBOUR_QUAL;
+
+	total = ROUTE->NBOUR_IFRAMES + ROUTE->NBOUR_RETRIES;
+	if (total >= TURBO_MQ_MIN_FRAMES)
+	{
+		successPct = (ROUTE->NBOUR_IFRAMES * 255) / total;
+		newMQ = (TURBO_MQ_ALPHA * successPct + (100 - TURBO_MQ_ALPHA) * turboMeasuredQual[idx]) / 100;
+		if (newMQ > 255) newMQ = 255;
+		if (newMQ < 1) newMQ = 1;
+		turboMeasuredQual[idx] = (UCHAR)newMQ;
+	}
+
+	baseQual = ROUTE->NEIGHBOUR_QUAL;
+	return (baseQual * turboMeasuredQual[idx] + 128) / 256;
+}
+
+static void turboSignalNewDest(void)
+{
+	if (!turboNewDestPending)
+	{
+		turboNewDestPending = 1;
+		turboNewDestTimer = 1 + turboRand(3); /* 1-4 second delay */
+	}
+}
+
+#endif /* TURBO_ROUTING */
+
 
