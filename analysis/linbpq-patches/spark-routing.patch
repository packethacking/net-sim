+#ifdef SPARK_ROUTING
+/*
+ * SPARK — Scalable Packet Adaptive Routing Kernel
+ *
+ * A ground-up replacement for NET/ROM's L3 routing logic, designed
+ * for the constraints of 1200-baud shared-medium packet radio:
+ *
+ *  1. EVENT-DRIVEN updates: route changes trigger immediate broadcasts
+ *     instead of waiting for the next periodic cycle.
+ *  2. INCREMENTAL updates: only changed routes are broadcast; full
+ *     dumps sent every SPARK_FULL_DUMP_INTERVAL cycles as backup.
+ *  3. TIMER JITTER: ±25% random jitter on all periodic timers to
+ *     prevent synchronized broadcast storms.
+ *  4. MEASURED QUALITY: actual frame success rate (EWMA) feeds back
+ *     into route quality, dynamically penalising degraded links.
+ *  5. SEQUENCE NUMBERS: per-origin monotonic counter eliminates
+ *     count-to-infinity and stale-route problems.
+ *  6. HOLD-DOWN: brief suppression after route removal prevents
+ *     oscillation from transient link flaps.
+ */
+
+#include <stdlib.h>
+
+#define SPARK_FULL_DUMP_INTERVAL  5   /* full dump every N broadcasts */
+#define SPARK_HOLDDOWN_CYCLES     2   /* suppress removed route for N cycles */
+#define SPARK_JITTER_PCT          25  /* ±25% jitter on timers */
+#define SPARK_EWMA_ALPHA          25  /* 25% weight on new sample (0-100) */
+#define SPARK_MIN_FRAMES_FOR_MQ   10  /* min frames before quality adjustment */
+#define SPARK_TRIGGERED_DELAY     0   /* disabled in v3 — use periodic only */
+#define SPARK_MIN_TRIG_INTERVAL   0   /* disabled in v3 */
+#define SPARK_MAX_QUALITY         255
+
+/* Per-destination state for SPARK */
+static UCHAR  sparkSeqNums[300][7];   /* origin call → last seen seq# (packed) */
+static USHORT sparkSeq[300];          /* sequence numbers, indexed by dest slot */
+static int    sparkSeqCount = 0;
+static UCHAR  sparkDirtyBits[300];    /* 1 = route changed since last broadcast */
+static UCHAR  sparkHolddown[300];     /* holddown cycles remaining */
+static int    sparkBroadcastCount = 0;
+static int    sparkTriggeredPending = 0;
+static int    sparkTriggeredTimer = 0;
+static int    sparkLastTriggeredAt = 0;  /* time() of last triggered broadcast */
+static USHORT sparkMySeq = 1;        /* our own sequence number */
+
+/* Per-neighbour measured quality (EWMA of success rate 0-255) */
+static UCHAR  sparkMeasuredQual[64]; /* indexed by neighbour slot */
+static int    sparkMQInited = 0;
+
+static int sparkRand(int max)
+{
+	return rand() % (max + 1);
+}
+
+static int sparkJitter(int base)
+{
+	int jit = (base * SPARK_JITTER_PCT) / 100;
+	if (jit < 1) jit = 1;
+	return base - jit + sparkRand(2 * jit);
+}
+
+static int sparkDestIndex(struct DEST_LIST * DEST)
+{
+	return (int)(DEST - DESTS);
+}
+
+static int sparkRouteIndex(struct ROUTE * ROUTE)
+{
+	return (int)(ROUTE - NEIGHBOURS);
+}
+
+static void sparkInitMQ(void)
+{
+	int i;
+	if (sparkMQInited) return;
+	for (i = 0; i < 64 && i < MAXNEIGHBOURS; i++)
+		sparkMeasuredQual[i] = 255;
+	/* Mark all existing destinations as dirty so first broadcast includes them */
+	memset(sparkDirtyBits, 1, sizeof(sparkDirtyBits));
+	memset(sparkHolddown, 0, sizeof(sparkHolddown));
+	sparkMQInited = 1;
+	srand((unsigned int)time(NULL) ^ (unsigned int)getpid());
+}
+
+/* Update the EWMA measured quality for a neighbour based on frame stats */
+static UCHAR sparkUpdateMQ(struct ROUTE * ROUTE)
+{
+	int idx = sparkRouteIndex(ROUTE);
+	int total, successPct, newMQ;
+
+	if (idx < 0 || idx >= 64) return 255;
+
+	total = ROUTE->NBOUR_IFRAMES + ROUTE->NBOUR_RETRIES;
+	if (total < SPARK_MIN_FRAMES_FOR_MQ)
+		return sparkMeasuredQual[idx];
+
+	successPct = (ROUTE->NBOUR_IFRAMES * 255) / total;
+
+	/* EWMA: new = alpha*sample + (1-alpha)*old */
+	newMQ = (SPARK_EWMA_ALPHA * successPct + (100 - SPARK_EWMA_ALPHA) * sparkMeasuredQual[idx]) / 100;
+	if (newMQ > 255) newMQ = 255;
+	if (newMQ < 1) newMQ = 1;
+
+	sparkMeasuredQual[idx] = (UCHAR)newMQ;
+	return (UCHAR)newMQ;
+}
+
+/* Compute effective quality for a route, incorporating measured quality */
+static int sparkEffectiveQual(struct ROUTE * ROUTE)
+{
+	int baseQual = ROUTE->NEIGHBOUR_QUAL;
+	UCHAR mq = sparkUpdateMQ(ROUTE);
+
+	/* Scale base quality by measured success rate */
+	return (baseQual * mq + 128) / 256;
+}
+
+/* Mark a destination as dirty (needs re-broadcast) */
+static void sparkMarkDirty(struct DEST_LIST * DEST)
+{
+	int idx = sparkDestIndex(DEST);
+	if (idx >= 0 && idx < 300)
+	{
+		sparkDirtyBits[idx] = 1;
+	}
+}
+
+#endif /* SPARK_ROUTING */
