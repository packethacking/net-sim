+		if (CompareCalls(ptr1, NETROMCALL))
+			Qual = 0;
+
+		PROCROUTES(DEST, ROUTE, Qual);
+		sparkMarkDirty(DEST);
+
+		ptr1 += 8;
+SparkIgnoreNode:;
