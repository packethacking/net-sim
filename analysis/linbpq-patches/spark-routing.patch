+/* SPARK broadcast: sends only dirty (changed) routes unless it's time
+ * for a periodic full dump.  Uses jittered timers throughout. */
+static void sparkSendBroadcast(int fullDump)
+{
+	struct PORTCONTROL * PORT = PORTTABLE;
+	dest_list * DEST;
+	MESSAGE * Buffer;
+	int Count, Qual;
+	UCHAR * ptr1, * ptr2;
+	int didx;
+
+	sparkInitMQ();
+	sparkMySeq++;
+
+	/* First broadcast must be full dump; also every N cycles */
+	if (sparkBroadcastCount == 0)
+		fullDump = 1;
+	sparkBroadcastCount++;
+
+	while (PORT)
+	{
+		if (PORT->PORTQUALITY == 0 || PORT->TXPORT || PORT->INP3ONLY)
+		{
+			PORT = PORT->PORTPOINTER;
+			continue;
+		}
+
+		Buffer = GetBuff();
+		if (Buffer == 0)
+			return;
+
+		Buffer->PORT = PORT->PORTNUMBER;
+		memcpy(Buffer->ORIGIN, NETROMCALL, 7);
+		memcpy(Buffer->DEST, NODECALL, 7);
+		Buffer->ORIGIN[6] |= 0x61;
+		Buffer->CTL = UI;
+		Buffer->PID = 0xCF;
+
+		ptr1 = &Buffer->L2DATA[0];
+		*(ptr1++) = 0xff;
+		memcpy(ptr1, MYALIASTEXT, 6);
+		ptr1 += 6;
+
+		Count = PORT->NODESPACLEN;
+		if (Count == 0) Count = 256;
+		if (Count < 50) Count = 50;
+		Count -= 22;
+		Count /= 21;
+
+		DEST = DESTS;
+		didx = 0;
+
+		while (DEST < ENDDESTLIST && Count > 0)
+		{
+			if (DEST->DEST_CALL[0] != 0x40 &&
+				DEST->NRROUTE[0].ROUT_QUALITY >= 1 &&
+				DEST->NRROUTE[0].ROUT_OBSCOUNT >= OBSMIN &&
+				(NODE == 1 || DEST->DEST_STATE & 0x80))
+			{
+				/* SPARK: skip if not dirty and this is an incremental update */
+				if (!fullDump && didx < 300 && !sparkDirtyBits[didx])
+				{
+					DEST++;
+					didx++;
+					continue;
+				}
+
+				ptr2 = &DEST->DEST_CALL[0];
+				memcpy(ptr1, ptr2, 13);
+				ptr1 += 13;
+
+				ptr2 = (UCHAR *)DEST->NRROUTE[0].ROUT_NEIGHBOUR;
+				if (ptr2 == 0)
+					ptr2 = MYCALL;
+				memcpy(ptr1, ptr2, 7);
+				ptr1 += 7;
+
+				Qual = 100;
+				if (DEST->NRROUTE[0].ROUT_NEIGHBOUR &&
+					DEST->NRROUTE[0].ROUT_NEIGHBOUR->NEIGHBOUR_PORT == PORT->PORTNUMBER)
+				{
+					Qual -= PORT->QUAL_ADJUST;
+				}
+				Qual *= DEST->NRROUTE[0].ROUT_QUALITY;
+				Qual /= 100;
+
+				*(ptr1++) = (UCHAR)Qual;
+				if (Qual == 0)
+				{
+					ptr1 -= 21; /* back out this entry */
+					DEST++;
+					didx++;
+					continue;
+				}
+				Count--;
+			}
+			DEST++;
+			didx++;
+		}
+
+		Buffer->LENGTH = (int)(ptr1 - (UCHAR *)Buffer);
+
+		/* Always send — even a header-only broadcast lets neighbours
+		 * discover us. The original NET/ROM code sends the first
+		 * fragment unconditionally for the same reason. */
+		if (PORT->TNC && PORT->TNC->Hardware == H_VARA)
+			SendVARANetromNodes(PORT->TNC, Buffer);
+		else
+			PUT_ON_PORT_Q(PORT, Buffer);
+
+		PORT = PORT->PORTPOINTER;
+	}
+
+	/* Clear dirty bits after broadcast */
+	memset(sparkDirtyBits, 0, sizeof(sparkDirtyBits));
+	sparkTriggeredPending = 0;
+
+	/* Decrement holddown timers */
+	{
+		int i;
+		for (i = 0; i < 300; i++)
+		{
+			if (sparkHolddown[i] > 0)
+				sparkHolddown[i]--;
+		}
+	}
+}
