+	SendNETROMRoute(PORT, Msg->ORIGIN);
+
+	if (ROUTE->NEIGHBOUR_FLAG == 0)
+		ROUTE->NEIGHBOUR_QUAL = PORT->PORTQUALITY;
+
+	time((time_t *)&Stamp);
+	Stamp = Stamp % 86400;
+	HH = (int)(Stamp / 3600);
+	Stamp -= HH * 3600;
